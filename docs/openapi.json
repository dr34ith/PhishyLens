    "/api/sigma": {
      "post": {
        "summary": "Generate Sigma rule(s) (YAML) from one finding {finding} or many {findings}; 422 for unsupported finding types",
        "tags": [
          "Detection"
        ],
        "responses": {
          "200": {
            "description": "Success: {rules: [{finding, title, id, yaml, rules}], skipped: [{finding, reason}], yaml}",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "rules": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "skipped": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "yaml": {
                      "type": "string",
                      "description": "All rules as multi-document Sigma YAML"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request: {error, request_id}"
          },
          "429": {
            "description": "Rate limited"
          },
          "500": {
            "description": "Internal error: {error, request_id}"
          },
          "422": {
            "description": "No Sigma template for the finding type(s): {error, supported[], request_id}"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "finding": {
                  "name": "SSH / Login Brute Force",
                  "severity": "HIGH",
                  "evidence": "203.0.113.50: 12 failed logins (2 distinct user(s): admin, root)",
                  "false_positive_possibility": "Low\u2013Medium.",
                  "confidence": 80
                },
                "mode": "logs"
              }
            }
          }
        }
      }
    },
