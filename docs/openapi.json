    "/api/report": {
      "post": {
        "summary": "Markdown (format=md) or print-ready HTML (format=html) write-up built only from an analysis result",
        "tags": [
          "Reporting"
        ],
        "responses": {
          "200": {
            "description": "The write-up as an attachment (Content-Disposition). IOC table always defanged; other text defanged when defang=true.",
            "content": {
              "text/markdown": {
